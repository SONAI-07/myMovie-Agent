# ==============================================================================
# bingeWatch 2.0 Environment Configuration
# ==============================================================================

# Required: Sarvam AI API Key for Theme Extraction & Curation (sarvam-105b)
SARVAM_API_KEY=your_sarvam_api_key_here

# Required for watch providers: TMDB API Read Access Token (Bearer) or API Key
# Sign up at https://www.themoviedb.org/settings/api to get a free key
TMDB_API_KEY=your_tmdb_api_key_or_read_access_token_here

# Target region code for streaming provider links (US, IN, GB, CA, etc.)
DEFAULT_REGION=US

# ==============================================================================
# Autonomous Gmail BookMyShow Ticket Ingestion (IMAP SSL)
# ==============================================================================
# Add your Gmail credentials to autonomously intercept orders@bookmyshow.com emails
# Note: Use a Google App Password (not your main Google account password).
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_CHECK_INTERVAL=60

# Optional: Secret token for webhook security header (Authorization: Bearer <token>)
WEBHOOK_SECRET=

# Server configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=production
DEBUG=false
